# =============================================================================
# JustMe Frontend — Variables de entorno
# =============================================================================
# Local: copia como `.env`
# Vercel: Settings → Environment Variables (Production, Preview, Development)
# =============================================================================

# Backend en Render
VITE_API_URL=https://justme-backend.onrender.com/api
VITE_API_BASE_URL=https://justme-backend.onrender.com

# Backend local (solo desarrollo)
# VITE_API_URL=http://localhost:3000/api
# VITE_API_BASE_URL=http://localhost:3000

VITE_GOOGLE_CLIENT_ID=
VITE_STRIPE_PUBLISHABLE_KEY=

# =============================================================================
# Despues del deploy en Vercel, actualiza en Render (backend):
#   CORS_ORIGIN=https://TU-APP.vercel.app
#
# Y en Google Cloud Console → OAuth → Authorized JavaScript origins:
#   https://TU-APP.vercel.app
# =============================================================================
